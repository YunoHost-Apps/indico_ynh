#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================

if [[ "${mail_user:-}" != "noreply" && "${mail_user:-}" != "contact" ]]; then
    mail_user="noreply"
    ynh_app_setting_set --key=mail_user --value="noreply" 
fi

ynh_app_setting_set_default --key=py_vshort --value="3.12"

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

    ynh_systemctl --service="$app-celery" --action="stop"
    ynh_systemctl --service="$app-granian" --action="stop"

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

    logourl=$(ynh_app_setting_get --key=logourl)
    
    ynh_config_add --template="indico.conf" --destination="$install_dir/etc/indico.conf"
    ynh_config_add --template=".env" --destination="$install_dir/.env"
    ynh_config_add --template="logging.yaml" --destination="$install_dir/logging.yaml"
    ynh_config_add --template="indico.wsgi" --destination="$install_dir/web/indico.wsgi"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files for mise..."
  ynh_setup_source --dest_dir="$install_dir/.mise/bin" --source_id="mise"
  chmod +x "$install_dir/.mise/bin/bin/mise"

ynh_script_progression "Preparing mise config..."
  export PATH="$install_dir/.mise/bin/bin:$PATH"
  export MISE_DATA_DIR="$install_dir/.mise/data"
  export MISE_CONFIG_DIR="$install_dir/.mise/config"
  export MISE_CACHE_DIR="$install_dir/.mise/cache"
  export MISE_STATE_DIR="$install_dir/.mise/state"
  export MISE_YES=1
  mkdir -p "$MISE_DATA_DIR" "$MISE_CONFIG_DIR" "$MISE_CACHE_DIR" "$MISE_STATE_DIR"
  ynh_config_add --template=".mise.toml" --destination="$install_dir/.mise.toml"
  ynh_config_add --template=".bashrc" --destination="$install_dir/.bashrc"

  ynh_hide_warnings eval "$(mise activate bash)"

ynh_script_progression "Upgrading source files..."

    pushd $install_dir
        ln -sf web/indico.wsgi wsgi.py
        ynh_hide_warnings mise run upgrade
    popd
    
    chown -R "$app:www-data" "$install_dir"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

    ynh_config_add_nginx
    
    ynh_config_add_systemd --service="$app-celery" --template="indico-celery.service"
    ynh_config_add_systemd --service="$app-granian" --template="indico-granian.service"
    
    yunohost service add "$app-celery" --description="Celery for indico" --log="/var/log/$app/$app-celery.log"
    yunohost service add "$app-granian" --description="granian for indico" --log="/var/log/$app/$app-granian.log"
    
    ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

    ynh_systemctl --service="$app-celery" --action="start"
    ynh_systemctl --service="$app-granian" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
